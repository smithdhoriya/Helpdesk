# --- Error monitoring (Sentry) -----------------------------------------------
# DSN for the "helpdesk-react" Sentry project. Get it from your Sentry
# project's Client Keys settings. Error monitoring only — tracing, session
# replay, and other Sentry features are not enabled.
VITE_SENTRY_DSN=""

# Environment tag reported alongside captured errors. Defaults to
# "development" when unset.
VITE_SENTRY_ENVIRONMENT=""
