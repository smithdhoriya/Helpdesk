# Connection string for the isolated E2E test database.
# Same Postgres instance as DATABASE_URL in .env.example, but a different
# database name so tests never touch dev/prod data.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk_test"

# Secret used by Better Auth to sign and encrypt sessions/cookies in tests.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL the API is served from during E2E test runs (isolated port).
BETTER_AUTH_URL="http://localhost:4001"

# Origin allowed to make credentialed requests to the API during tests (CORS).
TRUSTED_ORIGIN="http://localhost:5174"

# Isolated port so `bun run dev:test` can run alongside the normal dev server.
PORT=4001

# Used by `bun run db:test:seed` to create the test admin user.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Used by `bun run db:test:seed` to create a second, agent-role test user
# (needed for E2E role-based access control tests). Optional: if either is
# left blank, the seed script skips creating it.
AGENT_EMAIL=""
AGENT_PASSWORD=""
AGENT_NAME=""

# Shared secret the inbound-email webhook requires on the `x-webhook-secret`
# header during E2E test runs.
INBOUND_EMAIL_WEBHOOK_SECRET="test-webhook-secret"
