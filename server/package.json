{
  "name": "helpdesk-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "bun prisma/seed.ts",
    "dev:test": "bun --env-file=.env.test --watch src/index.ts",
    "db:test:migrate": "bun --env-file=.env.test node_modules/prisma/build/index.js migrate deploy",
    "db:test:seed": "bun --env-file=.env.test prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.23",
    "core": "workspace:*",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
