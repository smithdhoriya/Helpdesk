# Connection string for the PostgreSQL database.
# Use a strong, unique password for your database user — do not reuse this value across environments.
# The background job queue (pg-boss) reuses this same database, creating and
# managing its own `pgboss` schema; no separate connection or migration is needed.
DATABASE_URL=""

# Secret used by Better Auth to sign and encrypt sessions/cookies.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL the API is served from (used by Better Auth for callbacks/links).
BETTER_AUTH_URL="http://localhost:4000"

# Origin allowed to make credentialed requests to the API (CORS).
TRUSTED_ORIGIN="http://localhost:5173"

# Used by `bun run db:seed` to create the initial admin user.
# Set ADMIN_PASSWORD to a strong, unique password before running the seed script;
# generate one with: openssl rand -base64 24
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Shared secret the inbound-email webhook (POST /api/webhooks/inbound-email)
# requires on the `x-webhook-secret` header. Generate with: openssl rand -base64 32
INBOUND_EMAIL_WEBHOOK_SECRET=""

# Reply polishing (POST /api/tickets/:id/replies/polish) runs a local model
# through Ollama, so there is no API key and no per-call cost. Install Ollama
# and pull the model first: `ollama pull llama3.2`. If the daemon isn't running
# or the model isn't pulled, that endpoint returns 503 and the rest of the app
# works unchanged.

# Model to polish with. Any Ollama instruct model works; smaller ones respond
# faster. Defaults to llama3.2 when unset.
OLLAMA_MODEL="llama3.2"

# Where the Ollama daemon listens. Only needed when it isn't on this host —
# e.g. this server in a container talking to the host or a sidecar.
# Defaults to http://127.0.0.1:11434/api when unset.
OLLAMA_BASE_URL=""
