# Connection string for the PostgreSQL database.
# Use a strong, unique password for your database user — do not reuse this value across environments.
# The background job queue (pg-boss) reuses this same database, creating and
# managing its own `pgboss` schema; no separate connection or migration is needed.
DATABASE_URL=""

# Secret used by Better Auth to sign and encrypt sessions/cookies.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL the API is served from (used by Better Auth for callbacks/links).
BETTER_AUTH_URL="http://localhost:4000"

# Origin allowed to make credentialed requests to the API (CORS).
TRUSTED_ORIGIN="http://localhost:5173"

# Used by `bun run db:seed` to create the initial admin user.
# Set ADMIN_PASSWORD to a strong, unique password before running the seed script;
# generate one with: openssl rand -base64 24
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Shared secret the inbound-email webhook (POST /api/webhooks/inbound-email)
# requires on the `x-webhook-secret` header. Generate with: openssl rand -base64 32
INBOUND_EMAIL_WEBHOOK_SECRET=""

# AI features (reply polishing, ticket summarizing, inbound classification, and
# knowledge-base auto-resolution) call Google's Gemini API through the Vercel AI
# SDK. Get a key at https://aistudio.google.com/apikey. If the key is missing or
# invalid, or the model errors out, the relevant endpoint returns 503 and the
# rest of the app works unchanged.
GEMINI_API_KEY=""

# Model to use for all AI features. Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL="gemini-2.5-flash"

# --- Outbound email (SMTP) -------------------------------------------------
# When an agent replies to a ticket (POST /api/tickets/:id/replies) the reply is
# emailed to the customer through this SMTP server. For local development, run
# Mailpit — a zero-config SMTP server with a web inbox — and point these vars at
# it (see the "Local email (Mailpit)" section of the README/CLAUDE.md).
#
# Leave SMTP_HOST blank to disable outbound email entirely: replies are still
# saved, nothing is sent, and the app works unchanged (no credentials required).

# SMTP server hostname. Mailpit listens on localhost by default.
SMTP_HOST="localhost"

# SMTP server port. Mailpit's SMTP port is 1025. Defaults to 1025 when unset.
SMTP_PORT="1025"

# SMTP auth. Mailpit accepts unauthenticated mail, so leave both blank locally.
# Set them (and never commit real values) when pointing at a relay that needs auth.
SMTP_USER=""
SMTP_PASS=""

# Set to "true" for implicit TLS (port 465). Mailpit uses plain SMTP, so keep
# this false locally.
SMTP_SECURE="false"

# From header on outbound replies. Any address works with Mailpit — it captures
# everything. Defaults to "Helpdesk Support <support@helpdesk.local>" when unset.
MAIL_FROM="Helpdesk Support <support@helpdesk.local>"
