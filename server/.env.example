# Connection string for the PostgreSQL database.
# Use a strong, unique password for your database user — do not reuse this value across environments.
# The background job queue (pg-boss) reuses this same database, creating and
# managing its own `pgboss` schema; no separate connection or migration is needed.
DATABASE_URL=""

# Secret used by Better Auth to sign and encrypt sessions/cookies.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL the API is served from (used by Better Auth for callbacks/links).
BETTER_AUTH_URL="http://localhost:4000"

# Origin allowed to make credentialed requests to the API (CORS).
TRUSTED_ORIGIN="http://localhost:5173"

# Used by `bun run db:seed` to create the initial admin user.
# Set ADMIN_PASSWORD to a strong, unique password before running the seed script;
# generate one with: openssl rand -base64 24
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Shared secret the inbound-email webhook (POST /api/webhooks/inbound-email)
# used to require on the `x-webhook-secret` header. That route now verifies
# Resend's Svix-signed `email.received` webhook instead (see
# RESEND_WEBHOOK_SECRET below), so this is currently unused — kept, not
# removed, in case a non-Resend caller of this route is reintroduced.
INBOUND_EMAIL_WEBHOOK_SECRET=""

# AI features (reply polishing, ticket summarizing, inbound classification, and
# knowledge-base auto-resolution) call Google's Gemini API through the Vercel AI
# SDK. Get a key at https://aistudio.google.com/apikey. If the key is missing or
# invalid, or the model errors out, the relevant endpoint returns 503 and the
# rest of the app works unchanged.
GEMINI_API_KEY=""

# Model to use for all AI features. Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL="gemini-2.5-flash"

# --- Outbound email (Resend) ------------------------------------------------
# When an agent replies to a ticket (POST /api/tickets/:id/replies) the reply is
# emailed to the customer through the Resend API. Get a key at
# https://resend.com/api-keys.
#
# Leave RESEND_API_KEY blank to disable outbound email entirely: replies are
# still saved, nothing is sent, and the app works unchanged (no credentials
# required).
RESEND_API_KEY=""

# From header on outbound replies. Must be an address on a domain verified with
# Resend. Defaults to "Helpdesk Support <support@helpdesk.local>" when unset.
MAIL_FROM=""

# --- Inbound email (Resend) --------------------------------------------------
# POST /api/webhooks/inbound-email verifies Resend's Svix-signed `email.received`
# webhook with this signing secret, then uses RESEND_API_KEY (above) to fetch
# the received email's content from Resend's Receiving API. Get the signing
# secret from the webhook's settings page in the Resend dashboard after
# creating it (Webhooks > select the endpoint > Signing Secret).
RESEND_WEBHOOK_SECRET=""

# --- Error monitoring (Sentry) -----------------------------------------------
# DSN for the "helpdesk-express" Sentry project. Get it from your Sentry
# project's Client Keys settings. Error monitoring only — tracing, profiling,
# and other Sentry features are not enabled.
SENTRY_DSN=""

# Environment tag reported alongside captured errors. Defaults to
# "development" when unset.
SENTRY_ENVIRONMENT=""
